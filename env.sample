# Local development values only. Generate your own; never commit real secrets.
# CIPHER_KEY must be exactly 16 characters (aes-128-cbc).
CIPHER_KEY=change-me-16char

JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=soma_api_v2

APP_PORT=3066
WSS_PORT=3067

API_AUTH_LOGIN=change-me
API_AUTH_PASSWORD=change-me

# Local mail catcher (no outside SMTP on the offline desktop)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Third-party integrations: leave empty offline
FCM_SERVER_KEY=
FACEBOOK_ACCESS_TOKEN=
TWITTER_BEARER_TOKEN=

STREAM_API_URL=
STREAM_RECORDS_FOLDER_PATH=
